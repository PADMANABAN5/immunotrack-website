# Environment Configuration
NODE_ENV=development
APP_ENV=dev

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS Secrets Manager Secret Names
AWS_SECRET_NAME_DEV=immunotrack/dev/resend-api-key
AWS_SECRET_NAME_PROD=immunotrack/prod/resend-api-key

# Resend Contact Form Configuration
CONTACT_FORM_TO_EMAIL=contact@immunotrack.ai
CONTACT_FORM_FROM_EMAIL=ImmunoTrack Contact Form <contact@immunotrack.ai>

# Optional direct Resend API key fallback (overrides AWS Secrets Manager if set)
# RESEND_API_KEY=re_123456789
